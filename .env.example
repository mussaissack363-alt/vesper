# Required: Groq API key for LLM (get from https://console.groq.com)
GROQ_API_KEY=

# Optional: OpenRouter API key for vision fallback (get from https://openrouter.ai)
OPENROUTER_API_KEY=

# Optional: Override device detection ('mobile' or 'pc')
# VESPER_DEVICE=

# Optional: Firebase RTDB URL for cloud mirror (use your own project)
# FIREBASE_URL=https://your-project-default-rtdb.firebaseio.com